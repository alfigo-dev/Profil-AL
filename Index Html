
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profil-AL | Personal Portfolio</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Poppins:wght@300;400;500;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: #080b14;
    color: white;
    font-family: 'Poppins', sans-serif;
    overflow-x: hidden;
}

:root {
    --gold: #e9bd58;
    --dark: #080b14;
}

header {
    position: fixed;
    top: 0;
    width: 100%;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(8,11,20,0.85);
    backdrop-filter: blur(15px);
    z-index: 100;
    border-bottom: 1px solid rgba(233,189,88,0.15);
}

.logo {
    font-family: 'Orbitron', sans-serif;
    font-size: 23px;
    color: var(--gold);
    letter-spacing: 2px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 25px;
    font-size: 13px;
    transition: .3s;
}

nav a:hover {
    color: var(--gold);
}

.hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 100px 20px 50px;
    position: relative;
    background: radial-gradient(circle at center, #19202e 0%, #080b14 65%);
}

.hero::before {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    background: var(--gold);
    filter: blur(150px);
    opacity: .12;
    animation: glow 4s infinite alternate;
}

@keyframes glow {
    from { transform: scale(.8); opacity: .08; }
    to { transform: scale(1.4); opacity: .2; }
}

.hero-content {
    position: relative;
    z-index: 2;
    animation: appear 1.5s ease;
}

@keyframes appear {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
}

.tag {
    color: var(--gold);
    letter-spacing: 4px;
    font-size: 12px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(40px, 8vw, 75px);
    font-weight: 700;
    line-height: 1.2;
}

.hero h1 span {
    color: var(--gold);
    text-shadow: 0 0 25px rgba(233,189,88,.4);
}

.typing {
    color: #bbb;
    font-size: 18px;
    margin: 20px 0;
    min-height: 30px;
}

.cursor {
    color: var(--gold);
    animation: blink .7s infinite;
}

@keyframes blink {
    50% { opacity: 0; }
}

.description {
    max-width: 550px;
    color: #9299a8;
    font-size: 14px;
    line-height: 1.9;
}

.btn {
    display: inline-block;
    margin-top: 30px;
    padding: 13px 30px;
    background: var(--gold);
    color: #080b14;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    transition: .3s;
}

.btn:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 25px rgba(233,189,88,.5);
}

section {
    padding: 100px 10%;
}

.section-title {
    text-align: center;
    margin-bottom: 50px;
}

.section-title h2 {
    font-size: 32px;
}

.section-title span {
    color: var(--gold);
}

.section-title p {
    color: #9299a8;
    font-size: 13px;
    margin-top: 10px;
}

.about-card {
    max-width: 750px;
    margin: auto;
    padding: 35px;
    background: linear-gradient(145deg,#171e2b,#0c101a);
    border: 1px solid rgba(233,189,88,.2);
    border-radius: 20px;
    text-align: center;
    transition: .4s;
}

.about-card:hover {
    transform: translateY(-8px);
    border-color: var(--gold);
    box-shadow: 0 10px 40px rgba(233,189,88,.1);
}

.about-card p {
    color: #aeb4c0;
    font-size: 14px;
    line-height: 2;
}

.skills {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
    gap: 20px;
}

.skill-card {
    padding: 30px 20px;
    text-align: center;
    border-radius: 15px;
    background: #121927;
    border: 1px solid #252c39;
    transition: .4s;
}

.skill-card:hover {
    transform: translateY(-10px) scale(1.03);
    border-color: var(--gold);
    box-shadow: 0 0 25px rgba(233,189,88,.1);
}

.skill-card h3 {
    color: var(--gold);
    margin-bottom: 10px;
}

.skill-card p {
    color: #9299a8;
    font-size: 12px;
}

.contact {
    text-align: center;
    background: linear-gradient(180deg,#080b14,#151b28);
}

.contact p {
    color: #9299a8;
    margin-top: 15px;
}

footer {
    text-align: center;
    padding: 25px;
    color: #777;
    border-top: 1px solid #252c39;
    font-size: 12px;
}

/* Scroll animation */
.reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: 1s ease;
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

/* Mobile */
@media(max-width:600px) {
    header {
        padding: 17px 5%;
    }

    .logo {
        font-size: 17px;
    }

    nav a {
        margin-left: 10px;
        font-size: 10px;
    }

    section {
        padding: 80px 6%;
    }

    .about-card {
        padding: 25px;
    }
}
</style>
</head>

<body>

<header>
